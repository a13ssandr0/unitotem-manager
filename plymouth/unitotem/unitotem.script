// UniTotem boot splash (script plugin theme)
//
// Wordmark "Unit" + spinning "o" + "tem" on black, matching the boot-screen
// styling used by the webview (manager/webview/static/boot-screen.html:
// black background, white sans-serif text). The "o" doubles as the spinner.
//
// Bottom status line: fed by both Plymouth.SetUpdateStatusFunction and
// Plymouth.SetDisplayMessageFunction. Modern systemd sends the id of every
// unit that just finished starting (service/mount/swap) through the same
// channel "plymouth update --status=" uses - see
// src/core/manager.c:manager_send_unit_plymouth() in systemd - so no extra
// forwarder service is needed to show which unit is starting.
//
// Only Plymouth script primitives verified against the installed script.so
// (strings /usr/lib/*/plymouth/script.so) are used below: CharAt, SubString,
// Image.Text, Image.Rotate, Sprite, Window.Get*/SetBackground*Color.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_width  = Window.GetWidth(0);
screen_height = Window.GetHeight(0);

wordmark_font = "Sans Bold 48";
status_font   = "Sans 16";

// ---- Manual string helpers --------------------------------------------
// The script language has no built-in length/split/replace: build them from
// CharAt/SubString the same way the stock "breeze" theme does.

fun string_length(s) {
    for (i = 0; i < 512; i++) {
        if (String(s).CharAt(i) == "")
            return i;
    }
    return 512;
}

fun ends_with(s, suffix) {
    local.slen = string_length(s);
    local.suflen = string_length(suffix);
    if (suflen > slen) return false;
    return String(s).SubString(slen - suflen, suflen) == suffix;
}

fun strip_suffix(s, suffix) {
    if (ends_with(s, suffix))
        return String(s).SubString(0, string_length(s) - string_length(suffix));
    return s;
}

// First colon-separated token of s (mirrors the tokenizer in the stock
// "breeze" theme's update_status_callback).
fun first_token(s) {
    local.token = "";
    for (i = 0; i < 512; i++) {
        local.c = String(s).CharAt(i);
        if (c == "" || c == ":")
            return token;
        token += c;
    }
    return token;
}

// ---- Wordmark: "Unit" + spinning "o" + "tem" ---------------------------

unit_image = Image.Text("Unit", 1, 1, 1, 1, wordmark_font);
o_image    = Image.Text("o",    1, 1, 1, 1, wordmark_font);
tem_image  = Image.Text("tem",  1, 1, 1, 1, wordmark_font);

unit_sprite = Sprite(unit_image);
o_sprite    = Sprite(o_image);
tem_sprite  = Sprite(tem_image);

total_width = unit_image.GetWidth() + o_image.GetWidth() + tem_image.GetWidth();
wordmark_x  = screen_width  / 2 - total_width / 2;
wordmark_y  = screen_height / 2 - unit_image.GetHeight() / 2;

unit_sprite.SetPosition(wordmark_x, wordmark_y, 10);
tem_sprite.SetPosition(wordmark_x + unit_image.GetWidth() + o_image.GetWidth(), wordmark_y, 10);

// The "o" keeps a fixed on-screen center; Rotate() changes the image's
// bounding box each frame, so position is recomputed from that center.
o_center_x = wordmark_x + unit_image.GetWidth() + o_image.GetWidth() / 2;
o_center_y = wordmark_y + o_image.GetHeight() / 2;
o_sprite.SetPosition(o_center_x - o_image.GetWidth() / 2, o_center_y - o_image.GetHeight() / 2, 10);

spin_angle = 0;

fun refresh_callback() {
    spin_angle += 0.09;
    if (spin_angle > 6.283185307)
        spin_angle -= 6.283185307;

    local.rotated = o_image.Rotate(spin_angle);
    o_sprite.SetImage(rotated);
    o_sprite.SetX(o_center_x - rotated.GetWidth() / 2);
    o_sprite.SetY(o_center_y - rotated.GetHeight() / 2);
}
Plymouth.SetRefreshFunction(refresh_callback);

// ---- Bottom status line -------------------------------------------------

status_sprite = Sprite();
status_sprite.SetPosition(0, screen_height - 60, 10);
status_sprite.SetOpacity(0);

fun show_status(text) {
    if (text == "") {
        status_sprite.SetOpacity(0);
        return;
    }
    local.image = Image.Text(text, 0.7, 0.7, 0.7, 1, status_font);
    status_sprite.SetImage(image);
    status_sprite.SetX(screen_width / 2 - image.GetWidth() / 2);
    status_sprite.SetY(screen_height - 60);
    status_sprite.SetOpacity(1);
}

fun update_status_callback(status) {
    if (!status) return;

    if (first_token(status) == "fsck") {
        show_status("Checking filesystems...");
        return;
    }
    if (first_token(status) == "fsckd") {
        show_status("Checking filesystems...");
        return;
    }

    // A plain systemd unit id (service/mount/target/device/swap): drop the
    // unit-type suffix for readability, e.g. "NetworkManager.service" ->
    // "NetworkManager".
    local.label = status;
    label = strip_suffix(label, ".service");
    label = strip_suffix(label, ".mount");
    label = strip_suffix(label, ".target");
    label = strip_suffix(label, ".device");
    label = strip_suffix(label, ".swap");
    show_status(label);
}
Plymouth.SetUpdateStatusFunction(update_status_callback);

fun message_callback(text) {
    show_status(text);
}
Plymouth.SetDisplayMessageFunction(message_callback);

fun hide_message_callback(text) {
    show_status("");
}
Plymouth.SetHideMessageFunction(hide_message_callback);

// ---- Password / question prompts (e.g. LUKS passphrase) ------------------

fun display_password_callback(prompt, bullets) {
    local.text = prompt;
    if (!text) text = "Password";
    local.dots = "";
    for (i = 0; i < bullets; i++)
        dots += "*";
    show_status(text + " " + dots);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_question_callback(prompt, entry) {
    show_status(prompt + " " + entry);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_normal_callback() {
    show_status("");
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
