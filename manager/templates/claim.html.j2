{# The first-access claim code, for the person standing at the totem. The page opens an event stream (loopback only) and
   follows it, so a new code, or the node being claimed, shows up at once without anybody reloading anything. #}
<style>
    #claim {
        display: none;
        position: absolute;
        right: 0;
        bottom: 0;
        margin: 2vw;
        padding: 1.2vw 2vw;
        max-width: 40vw;
        text-align: center;
        background: rgba(0, 0, 0, 0.65);
        border: 0.2vw solid #fff;
        border-radius: 1vw;
        color: #fff;
    }
    #claim.on { display: block; }
    #claim .claim-title { font-size: 1.6vw; margin: 0 0 0.4vw; }
    #claim .claim-code { font-size: 4vw; font-weight: 700; letter-spacing: 0.3vw; font-family: monospace; }
    #claim .claim-hint { font-size: 1.2vw; margin: 0.4vw 0 0; }
</style>
<div id="claim" class="{{ 'on' if claim_code else '' }}">
    <p class="claim-title">Set up this device</p>
    <div class="claim-code" id="claim-code">{{ claim_code or '' }}</div>
    <p class="claim-hint">Open <b>https://{{ ip_addr or hostname }}/setup</b> from another device<br>and enter this code to create the administrator.</p>
</div>
<script>
    (function () {
        if (!window.EventSource) return;
        var box = document.getElementById('claim'), code = document.getElementById('claim-code');
        new EventSource('/unitotem-claim/events').onmessage = function (event) {
            var state = JSON.parse(event.data);
            code.textContent = state.code || '';
            box.className = state.code ? 'on' : '';
        };
    })();
</script>
