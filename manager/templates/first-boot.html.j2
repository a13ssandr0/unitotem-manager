<!DOCTYPE html>
<html lang="en">

<head>
    <title>UniTotem Manager</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body {
            background: #23a6d5;
            /* The browser's default 8px body margin plus a full-viewport height
               adds up to more than the viewport, which is what put a scrollbar
               on a kiosk screen that can never be scrolled. */
            margin: 0;
            height: 100vh;
            color: white;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
        }
        /* The moving gradient is two static layers cross-faded: only `opacity` changes, which the compositor does without
           repainting anything (the earlier animation of background-position repainted the whole screen every frame and kept
           the CPU busy for as long as this page was shown), and in steps, so a machine with no GPU recomposes 10 times a second. */
        .bg {
            position: fixed;
            inset: 0;
            z-index: -1;
            will-change: opacity;
        }
        .bg.a { background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab); }
        .bg.b {
            background: linear-gradient(-45deg, #23d5ab, #23a6d5, #e73c7e, #ee7752);
            opacity: 0;
            animation: crossfade 10s steps(25) infinite alternate;
        }
        @keyframes crossfade {
            to { opacity: 1; }
        }
        .welcome {
            transform: scale(0.75);
            animation: scale 3s forwards cubic-bezier(0.5, 1, 0.89, 1);
        }
        @keyframes scale {
            100% {
                transform: scale(1);
            }
        }
        span {
            opacity: 0;
            filter: blur(4px);
        }
        span:nth-child(1) {
            animation: fade-in 0.8s 0.1s forwards cubic-bezier(0.11, 0, 0.5, 0);
        }
        span:nth-child(2) {
            animation: fade-in 0.8s 1s forwards cubic-bezier(0.11, 0, 0.5, 0);
        }
        span:nth-child(3) {
            animation: fade-in 0.8s 2s forwards cubic-bezier(0.11, 0, 0.5, 0);
        }
        @keyframes fade-in {
            100% {
                opacity: 1;
                filter: blur(0);
            }
        }
        code {
            background: #f2f1f1;
            color: #d63384;
            border-radius: 0.25vw;
            padding: .125vw .25vw;
            width: -webkit-fit-content;
            width: -moz-fit-content;
            width: fit-content;
        }
        svg {
            width: 20vw;
        }
        h1 {
            font-size: 3.5vw;
            margin-top: 0;
            margin-bottom: 0.5rem;
            text-align: center;
            font-weight: 500;
            line-height: 1.2;
        }
        h5 {
            font-size: 1.5vw;
            margin-top: 0;
            margin-bottom: 0.5rem;
            text-align: center;
            font-weight: 500;
            line-height: 1.2;
        }
        .qr {
            margin-top: 3.5rem;
            text-align: center;
        }
        main {
            position: absolute;
            transform: translate(-50%, -50%);
            left: 50%;
            top: 50%;
        }
        .sysinfo {
            position: absolute;
            left: 0;
            bottom: 0;
            margin: 1vw;
        }
    </style>
</head>

<body>
    <div class="bg a"></div><div class="bg b"></div>
    <main>
        <span><h1 class="welcome"><b>Welcome to UniTotem</b></h1></span>
        {% if wifi %}
        <span><h5 class="welcome">Connect to <code>{{wifi.ssid}}</code> wifi with password <code>{{wifi.password}}</code> to begin.</h5></span>
        <span><div class="qr welcome">{{wifi.qrcode|safe}}</div></span>
        {% endif %}
    </main>

    <div class="sysinfo">
        <p style="font-size: 1vw; margin-block:0;">UniTotem {{ut_vers}}<br>Running on {{os_vers}}<br>IP address: <span id="ip">{{ip_addr}}</span><br>Hostname: {{hostname}}</p>
    </div>
<script>
    // the address is pushed by the manager when the network changes (DHCP can finish after this page was drawn)
    const events = new EventSource('/unitotem-first-boot/address');
    events.onmessage = e => { document.getElementById('ip').textContent = e.data; };
</script>
</body>

</html>