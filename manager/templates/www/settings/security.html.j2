{% endblock content %}

{% set init_cmds = ['Settings/Security/getUsers'] %}

<script type="text/javascript" charset="utf-8">
{% block js %}
{#const pwd1 = $('#inputNewPassword');#}
{#const pwd2 = $('#inputNewPassword2');#}
{#const sub = $('#set_passwd');#}
{#pwd1.on('input', () => sub.prop('disabled', (pwd1.val() === '') || (pwd1.val() !== pwd2.val())));#}
{#pwd2.on('input', () => sub.prop('disabled', (pwd1.val() === '') || (pwd1.val() !== pwd2.val())));#}
const user_modal = new bootstrap.Modal('#userModal');
const userNameInput = $('#userNameInput');
const userPasswordInput = $('#userPasswordInputA');
const userPasswordInput2 = $('#userPasswordInputB');
const user_modal_title = $('#userModalLabel');
const user_table = $('#usertable');

$('#userModal').on('show.bs.modal', e => {
    const button = e.relatedTarget;
    const title = button.getAttribute('data-bs-title');
    const user = button.getAttribute('data-bs-user');

    user_modal_title.html(title);
    if (user !== null){
        userNameInput.attr('disabled', true).attr('value', user);
    } else {
        userNameInput.attr('disabled', false).attr('value', '');
    }
})

userPasswordInput.on('input', ()=>{
    userPasswordInput.removeClass('is-invalid');
    userPasswordInput2.removeClass('is-invalid');
})
userPasswordInput2.on('input', ()=>{
    userPasswordInput.removeClass('is-invalid');
    userPasswordInput2.removeClass('is-invalid');
})

$('#user-modal-save').click(()=>{
    //user_modal.dismiss();
    let name = userNameInput.val();
    let passwd = userPasswordInput.val();
    let passwd2 = userPasswordInput2.val();

    if (passwd!==passwd2){
        userPasswordInput.addClass('is-invalid');
        userPasswordInput2.addClass('is-invalid');
    } else if (userNameInput.attr('disabled') === undefined) {
        user_modal.hide();
        userPasswordInput.val('');
        userPasswordInput2.val('');
        sendCommand('Settings/Security/addUser', {username:name, password:passwd});
    } else {
        user_modal.hide();
        userPasswordInput.val('');
        userPasswordInput2.val('');
        sendCommand('Settings/Security/setUserPass', {username:name, password:passwd});
    }

});


function do_chkbox(e){
    let selected = [... $(`[name=${e.target.name}]:checked`).map((_, el) => el.value)];
    sendCommand('Settings/Security/setUserPerms', {username: e.target.name, perms: selected});
}


handle('Settings/Security/getUsers', data => {
    user_table.empty();
    data.users.forEach(([user,userdata])=>{
        user_table.append(
            $('<tr></tr>').append(
                $('<th scope="col"></th>').html(user),
                $('<td class="text-center align-middle"></td>').append(
                    $('<input class="form-check-input" type="checkbox" value="scheduler">').attr("name", user)
                            .prop("checked", userdata.perms.includes("scheduler")||userdata.perms.includes("admin"))
                            .prop("disabled", userdata.perms.includes("admin"))
                            .change(do_chkbox),
                ),
                $('<td class="text-center align-middle"></td>').append(
                    $('<input class="form-check-input" type="checkbox" value="audio">').attr("name", user)
                            .prop("checked", userdata.perms.includes("audio")||userdata.perms.includes("admin"))
                            .prop("disabled", userdata.perms.includes("admin"))
                            .change(do_chkbox),
                ),
                $('<td class="text-center align-middle"></td>').append(
                    $('<input class="form-check-input" type="checkbox" value="power">').attr("name", user)
                            .prop("checked", userdata.perms.includes("power")||userdata.perms.includes("admin"))
                            .prop("disabled", userdata.perms.includes("admin"))
                            .change(do_chkbox),
                ),
                $('<td class="text-center align-middle"></td>').append(
                    $('<input class="form-check-input" type="checkbox" value="admin">').attr("name", user)
                            .prop("checked", userdata.perms.includes("admin")).change(do_chkbox),
                ),
                $('<td class="d-flex justify-content-center"></td>').append(
                    $('<div class="btn-group" role="group"></div>').append(
                        $('<button type="button" title="Edit user" class="btn btn-sm btn-outline-warning" ' +
                            'data-bs-toggle="modal" data-bs-target="#userModal"><i class="bi bi-pencil"></i></button>')
                                .attr('data-bs-title', "Edit user")
                                .attr('data-bs-user', user),
                        $('<button type="button" title="Delete user" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>').click(()=>{
                            sendCommand('Settings/Security/delUser', {user: user})
                        })
                    )
                )
            )
        )
    });
})

{% endblock js %}
</script>
