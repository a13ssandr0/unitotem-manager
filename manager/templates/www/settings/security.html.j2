{% extends "settings.html.j2" %}

<style>
{% block custom_style %}
.no-border {
    border-bottom-style: none;
    border-top-style: none;
}
{% endblock custom_style %}
</style>

{% block body_top %}
<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userModalLabel">New user</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="userNameInput" placeholder="Name">
                    <label for="userNameInput">Name</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="password" class="form-control" id="userPasswordInputA" placeholder="Password">
                    <label for="userPasswordInputA">Password</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="password" class="form-control" id="userPasswordInputB" placeholder="Repeat password">
                    <label for="userPasswordInputB">Repeat password</label>
                    <div class="invalid-feedback">
                        Passwords do not match.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="user-modal-save">Save</button>
            </div>
        </div>
    </div>
</div>


{% endblock body_top %}


{% block content %}
<div class="row">
    <div class="col col-xl-8 col-xxl-6">
        <h4>Users</h4>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col" rowspan="2" class="col-2 align-middle">Username</th>
                    <th scope="col" colspan="4" class="text-center no-border">Permissions</th>
                    <th scope="col" rowspan="2" class="col-2"></th>
                </tr>
                <tr>
                    <td class="text-center">Scheduler</td>
                    <td class="text-center">Audio</td>
                    <td class="text-center">Power</td>
                    <td class="text-center">Admin</td>
                </tr>
            </thead>
            <tbody id="usertable"></tbody>
            <tfoot>
                <tr>
                    <td colspan="6">
                        <div class="d-grid">
                            <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#userModal"
                                    data-bs-title="New user">
                                <i class="bi bi-person-add"></i> New user
                            </button>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
{#<div class="form-floating mb-3" style="max-width: 30em;">
    <input type="email" class="form-control" id="loggedUser" placeholder="admin" value="{{logged_user.name}}" disabled>
    <label for="loggedUser">Username</label>
</div>
