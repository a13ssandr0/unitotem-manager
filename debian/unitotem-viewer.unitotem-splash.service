[Unit]
Description=UniTotem boot splash
# Started in parallel with the compositor on purpose: the program loads everything it needs first and then waits for the
# Wayland socket itself, so the first frame is drawn the moment the compositor accepts clients

[Service]
# Ready when the first frame is on screen: this is what the boot splash of the system can end on. The viewer stops the
# service once its own splash is showing.
Type=notify
NotifyAccess=main
TimeoutStartSec=120
Environment=WAYLAND_DISPLAY=/run/unitotem/xdg/wayland-0
ExecStart=/usr/bin/python3 /usr/share/unitotem-manager/plugins/unitotem_viewer/bootsplash.py

[Install]
WantedBy=multi-user.target
