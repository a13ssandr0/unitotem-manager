#!/usr/bin/python3 -I
"""
First access: creates the first administrator of a UniTotem node.

Installed as the login shell of root and as the sshd ForceCommand of the first-access window. Whatever the caller
passes (`shell -c <command>`, sftp subsystem, environment) is ignored: this program never runs anything else.
"""
import getpass
import os
import signal
import sys
import syslog
import traceback

# Where the manager modules (utils/) are installed by unitotem-manager (debian/rules).
MANAGER_DIR = '/usr/share/unitotem-manager'
CLEAN_ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'}
TIMEOUT_SECONDS = 300
ATTEMPTS = 3

MSG_ADMIN_EXISTS = 'Root accepts SSH keys only. Log in with an administrator account.'
MSG_NO_TERMINAL_FIRST = 'First access: connect with an interactive terminal (ssh -t).'
MSG_FAILED = 'First access failed. Details are in the system log.'
MSG_READ_ONLY = 'Storage is read-only. Account creation is not possible.'
MSG_VOLATILE = 'No data partition: settings are lost on reboot.'
# Written by the initramfs overlay hook: one line, `volatile:<reason>` when DATA is absent or unusable (state in RAM).
OVERLAY_STATUS = '/run/unitotem-overlay.status'
ETC_DIR = '/etc'


def _log_to_syslog(text: str):
    syslog.openlog('unitotem-first-admin')
    for line in text.rstrip().splitlines():
        syslog.syslog(syslog.LOG_ERR, line)


def _exit_on_signal(signum, frame):
    raise SystemExit(1)


def _exit_on_timeout(signum, frame):
    os.write(sys.stdout.fileno(), b'Timed out.\n')
    raise SystemExit(1)


def _install_signals() -> list:
    """Clean exit on interruption, 5-minute limit. Returns the previous handlers for restoring."""
    previous = []
    for signum in (signal.SIGINT, signal.SIGQUIT, signal.SIGTSTP, signal.SIGHUP, signal.SIGTERM):
        previous.append((signum, signal.signal(signum, _exit_on_signal)))
    previous.append((signal.SIGALRM, signal.signal(signal.SIGALRM, _exit_on_timeout)))
    signal.alarm(TIMEOUT_SECONDS)
    return previous


def _restore_signals(previous: list):
    signal.alarm(0)
    for signum, handler in previous:
        signal.signal(signum, handler)


def _read_only(etc_dir) -> bool:
    """True when /etc is on a read-only mount (no write probe: nothing is written)."""
    return bool(os.statvfs(etc_dir).f_flag & os.ST_RDONLY)


def _volatile(overlay_status) -> bool:
    """True when the overlay hook recorded a volatile state (settings are lost on reboot)."""
    try:
        with open(overlay_status, encoding='utf-8') as status:
            return status.readline().rstrip('\n') .startswith('volatile:')
    except (OSError, UnicodeDecodeError):
        return False


def _run(input_fn, getpass_fn, manager_dir, is_tty, etc_dir, overlay_status) -> int:
    sys.path.insert(0, manager_dir)
    from utils import first_access, osusers, passwords
    from loguru import logger

    # Library messages go to the system log, never to the terminal
    logger.remove()
    logger.add(lambda message: syslog.syslog(syslog.LOG_WARNING, str(message).rstrip()), level='WARNING')

    if not is_tty():
        print(MSG_ADMIN_EXISTS if osusers.admin_exists() else MSG_NO_TERMINAL_FIRST)
        return 1
    if osusers.admin_exists():
        print(MSG_ADMIN_EXISTS)
        return 0
    if _read_only(etc_dir):
        print(MSG_READ_ONLY)
        return 1
    if _volatile(overlay_status):
        print(MSG_VOLATILE)

    print('Password rules:')
    for rule in passwords.rules_spec()['rules']:
        print(f"  - {rule['text']}")
    for _ in range(ATTEMPTS):
        name = input_fn('User name: ').strip()
        problems = passwords.validate_username(name)
        if name == 'root':
            problems.append('The username root is reserved')
        if not osusers.valid_name(name) and not problems:
            problems.append('The username is not valid')
        if problems:
            print('\n'.join(problems))
            continue

        password = getpass_fn('Password: ')
        again = getpass_fn('Password again: ')
        if password != again:
            print('The passwords do not match.')
            continue
        problems = passwords.validate_password(password, name)
        if problems:
            print('\n'.join(problems))
            continue

        try:
            first_access.create_first_admin(name, password)
        except first_access.FirstAccessDone:
            print(MSG_ADMIN_EXISTS)
            return 0
        except first_access.FirstAccessBusy:
            print('Another first access is in progress. Try again in a minute.')
            return 1
        except osusers.OSUserError as exc:
            print(exc)
            continue
        print(f'Administrator {name} created. Log in again as {name}.')
        return 0

    print('Too many attempts.')
    return 1


def main(argv_ignored=None, *, input_fn=input, getpass_fn=getpass.getpass, manager_dir=MANAGER_DIR,
         is_tty=None, etc_dir=ETC_DIR, overlay_status=OVERLAY_STATUS) -> int:
    # argv_ignored is accepted only so that every caller shape works: nothing in it is read
    os.umask(0o077)
    os.environ.clear()
    os.environ.update(CLEAN_ENV)
    if is_tty is None:
        is_tty = sys.stdin.isatty
    previous = _install_signals()
    try:
        return _run(input_fn, getpass_fn, manager_dir, is_tty, etc_dir, overlay_status)
    except (EOFError, KeyboardInterrupt):
        return 1
    except SystemExit:
        raise
    except Exception:
        _log_to_syslog(traceback.format_exc())
        print(MSG_FAILED)
        return 1
    finally:
        _restore_signals(previous)


if __name__ == '__main__':
    sys.exit(main())
