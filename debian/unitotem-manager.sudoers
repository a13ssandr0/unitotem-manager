# Sudoers drop-in: allow the unitotem service user to run apt-get
# without a password. Commands are restricted to the exact paths below.
# Installed by the unitotem-manager package into /etc/sudoers.d/.

Cmnd_Alias UNITOTEM_APT = \
    /usr/bin/apt-get update, \
    /usr/bin/apt-get dist-upgrade -y, \
    /usr/bin/apt-get install -y *, \
    /usr/bin/apt-get remove -y *, \
    /usr/bin/apt-get autoremove -y, \
    /usr/bin/apt-get clean, \
    /usr/bin/apt-get autoclean

unitotem ALL = NOPASSWD: UNITOTEM_APT
