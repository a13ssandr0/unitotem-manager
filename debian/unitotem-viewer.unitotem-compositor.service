[Unit]
Description=UniTotem compositor (labwc)
# Plymouth keeps its last frame on screen while the compositor starts and is removed once the compositor answers. Measured on a
# Pi 4 with the X server this replaces (2026-10-17, capture of the HDMI output): `plymouth quit` blanks the screen at once,
# `plymouth deactivate` does not (it only stops drawing and gives up the DRM master, so the new owner can take it, and the last
# frame stays scanned out). The time the compositor needs to initialise is covered by the Plymouth frame.
After=plymouth-start.service systemd-udevd.service
Before=unitotem-manager.service
# Like gdm3 and lightdm in Debian: the service that takes over the screen replaces plymouth-quit.service and quits Plymouth itself. Debian's
# plymouth-quit.service runs a plain `plymouth quit` about a second after Plymouth starts, before the compositor exists: the VT goes back to
# text mode and the kernel console repaints the boot text (kernel errors, systemd status lines) over the splash (measured on the amd64 test PC with the HDMI
# capture, 2026-11-26: a burst of console text and black at the hand-over). OnFailure keeps Debian's safety net: if this unit fails Plymouth still quits.
Conflicts=plymouth-quit.service plymouth-quit-wait.service
OnFailure=plymouth-quit.service

[Service]
Type=simple
# Everything the program and the node write for the compositor lives in /run/unitotem: the XDG runtime directory (the Wayland
# socket; it must be private) and one configuration fragment per writer (manager/utils/labwc.py: the node's, for touch screens). /run is a tmpfs: nothing
# can be left behind by a crash or a power cut.
RuntimeDirectory=unitotem unitotem/xdg unitotem/labwc/node/labwc
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# labwc runs on VT1, the VT Plymouth is on; libseat's builtin backend needs a VT and no seat daemon
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UnsetEnvironment=TERM
Environment=XDG_RUNTIME_DIR=/run/unitotem/xdg
Environment=LIBSEAT_BACKEND=builtin
# Only the manager drives the compositor and nothing it shows is translated, so it runs in the C locale. This matters for numbers: labwc reads a touch
# panel's calibration matrix with the C library's strtof in the language of the process, and under a locale with a decimal comma "1.06" is refused and
# the whole matrix silently dropped (the matrices that are only turns and mirrors have no decimals, which hid it).
Environment=LANG=C
# base configuration of the image, then the fragment of the node (touch screens)
Environment=XDG_CONFIG_DIRS=/usr/share/unitotem/xdg:/run/unitotem/labwc/node
# the theme paints the status line on its next refresh (50 Hz); the pause lets the frame that stays on screen show "Starting compositor" before `deactivate` freezes it
ExecStartPre=-/usr/bin/plymouth update --status="Starting compositor"
ExecStartPre=-/bin/sleep 0.2
ExecStartPre=-/usr/bin/timeout 5 /usr/bin/plymouth deactivate
ExecStartPre=/bin/chmod 700 /run/unitotem/xdg
# the boot splash draws its first frame only after the outputs are turned as saved (output_transform.py removes this file): it must exist before the socket does
ExecStartPre=/bin/touch /run/unitotem/xdg/output-pending
ExecStartPre=/bin/sh -c 'for n in node; do f=/run/unitotem/labwc/$n/labwc/rc.xml; [ -e "$f" ] || printf \'<?xml version="1.0"?>\\n<labwc_config>\\n</labwc_config>\\n\' > "$f"; done'
ExecStart=/usr/bin/labwc --merge-config
# once the compositor really answers (the socket exists), turn and mirror the outputs as saved; then quit Plymouth with `--retain-splash`, as gdm and sddm
# do: the splash stays on screen and the VT stays in graphics mode (a plain quit puts it back in text mode and the console repaints). Plymouth is already
# deactivated, so this only ends the process. The screen is not cleared: the retained frame stays until the compositor and the splash paint over it (clearing
# /dev/fb0 or tty1 blanked it).
ExecStartPost=-/bin/sh -c 'i=0; until [ -S /run/unitotem/xdg/wayland-0 ] || [ $i -ge 400 ]; do sleep 0.05; i=$((i+1)); done; /usr/bin/python3 /usr/share/unitotem-manager/plugins/unitotem_viewer/output_transform.py; /usr/bin/plymouth quit --retain-splash'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
