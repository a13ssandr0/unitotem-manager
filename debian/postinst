#!/bin/bash

if [ "$1" == "configure" ] && [ -z "$2" ]; then
	# if $2 is null we are installing, run first setting code

	echo "Creating ssl key for UniTotem"
	openssl req -x509 -nodes -newkey rsa:2048 -keyout "/etc/ssl/unitotem_key.pem" -out "/etc/ssl/unitotem_crt.pem" -days 365000 -subj "/C=../ST=./L=./O=a13ssandr0/OU=UniTotem/CN=UniTotem/emailAddress=."
	cat /etc/ssl/unitotem_{crt,key}.pem > "/etc/ssl/unitotem.pem"
	rm /etc/ssl/unitotem_{crt,key}.pem
	chmod 0600 "/etc/ssl/unitotem.pem"

fi


# https://stackoverflow.com/questions/66775654/how-can-i-make-pulseaudio-run-as-root

if [ "$1" == "configure" ]; then
	# The venv is prebuilt and shipped inside the package (see debian/rules).
	# CAP_NET_BIND_SERVICE is stored as a file xattr, which dpkg's data.tar
	# does not reliably preserve across (re)install, so it must be reapplied
	# on every install AND every upgrade, not just the first install.
	setcap CAP_NET_BIND_SERVICE=+eip /var/unitotem-venv/bin/python
	setcap CAP_NET_BIND_SERVICE=+eip /var/unitotem-venv/bin/python3

	getent group unitotem >/dev/null || addgroup --system unitotem
	# reading raw block devices (to compute free space on unmounted filesystems)
	# requires membership in the "disk" group; also reapplied on upgrade in
	# case this device was set up before this fix existed
	if id -u unitotem &>/dev/null; then
		usermod -aG disk unitotem
	fi

	# ── netplan renderer check ────────────────────────────────────────────────
	# UniTotem manages networking exclusively through NetworkManager DBus.
	# Netplan must therefore use NetworkManager as its renderer.
	# If no netplan file already sets this, we create a minimal one.
	NETPLAN_DIR=/etc/netplan
	NM_RENDERER_FOUND=0

	if [ -d "$NETPLAN_DIR" ]; then
		for f in "$NETPLAN_DIR"/*.yaml "$NETPLAN_DIR"/*.yml; do
			[ -f "$f" ] || continue
			if grep -qE "^\s*renderer\s*:\s*NetworkManager" "$f"; then
				NM_RENDERER_FOUND=1
				echo "netplan renderer already set to NetworkManager in $f"
				break
			fi
		done
	fi

	if [ "$NM_RENDERER_FOUND" -eq 0 ]; then
		echo "Setting netplan renderer to NetworkManager"
		mkdir -p "$NETPLAN_DIR"
		cat > "$NETPLAN_DIR/01-unitotem-nm.yaml" << 'EOF'
# Generated by unitotem-manager installer.
# Sets NetworkManager as the netplan renderer so that UniTotem can manage
# network connections via DBus without needing direct file access.
network:
  version: 2
  renderer: NetworkManager
EOF
		chmod 600 "$NETPLAN_DIR/01-unitotem-nm.yaml"
		netplan apply || true
	fi

	# ── Plymouth theme ────────────────────────────────────────────────────────
	# Registered as a high-priority alternative so it becomes the default
	# automatically (update-alternatives picks the highest priority unless an
	# admin has manually pinned another theme via --config). update-initramfs
	# embeds it into initrd; the plymouth package's own initramfs-tools hook
	# does the actual copying, no custom hook needed. Re-run on every upgrade
	# too, in case the theme's script/images changed.
	if [ -f /usr/share/plymouth/themes/unitotem/unitotem.plymouth ]; then
		update-alternatives --install /usr/share/plymouth/themes/default.plymouth \
			default.plymouth /usr/share/plymouth/themes/unitotem/unitotem.plymouth 100
		if command -v update-initramfs >/dev/null; then
			update-initramfs -u
		fi
	fi

	# check if chromium allows remote control
	# this means the systems is configured for running UniTotem
	grep -Fq "remote-debugging-port" /etc/X11/xinit/xinitrc
	if [[ $? -eq 0 ]]; then
		# if the string "no-user-gesture-required" is not present
		# we are surely updating from an older version of UniTotem that
		# let chromium automatically generate pages for displaying images and videos
		# new pages generated by UniTotem need this flag to allow autoplay
		grep -Fq "no-user-gesture-required" /etc/X11/xinit/xinitrc
		if [[ $? -ne 0 ]]; then
			awk '/--incognito.*/{print "\t--autoplay-policy=no-user-gesture-required \\"}1' /etc/X11/xinit/xinitrc > /etc/X11/xinit/xinitrc.tmp
			mv /etc/X11/xinit/xinitrc.tmp /etc/X11/xinit/xinitrc
		fi
	fi
fi

#DEBHELPER#
