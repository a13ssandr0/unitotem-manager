From f5e4304091f460e11974f09f64e4a857e4bfc5e1 Mon Sep 17 00:00:00 2001
From: Alessandro Campolo <campolo.alex@gmail.com>
Date: Tue, 20 Oct 2026 22:05:33 +0000
Subject: [PATCH 4/6] views: Use the entered output for CefWindow::GetDisplay
 on Wayland

CefWindowView::GetDisplay() looks for the Display that best matches the
window bounds. A Wayland client cannot know where its toplevel is in the
global coordinate space (the bounds start at 0,0), so a window on the
second output was reported as being on the first. Use
display::Screen::GetDisplayNearestWindow(), which follows the outputs
the surface has entered, on Wayland.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 libcef/browser/views/window_view.cc | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/libcef/browser/views/window_view.cc b/libcef/browser/views/window_view.cc
index 9382c9dd3..e4b1e87b0 100644
--- a/libcef/browser/views/window_view.cc
+++ b/libcef/browser/views/window_view.cc
@@ -893,6 +893,15 @@ void CefWindowView::OnWidgetBoundsChanged(views::Widget* widget,
 display::Display CefWindowView::GetDisplay() const {
   const views::Widget* widget = GetWidget();
   if (widget) {
+#if BUILDFLAG(IS_OZONE)
+    if (view_util::IsRunningOnWayland()) {
+      // A Wayland client does not know the position of its toplevel in the
+      // global coordinate space, so the window bounds say nothing about the
+      // Display. Use the output(s) the surface has entered.
+      return display::Screen::Get()->GetDisplayNearestWindow(
+          widget->GetNativeWindow());
+    }
+#endif
     return view_util::GetDisplayMatchingBounds(
         widget->GetWindowBoundsInScreen(), false);
   }
