+#ifndef CEF_INCLUDE_VIEWS_CEF_DISPLAY_OBSERVER_H_
+#define CEF_INCLUDE_VIEWS_CEF_DISPLAY_OBSERVER_H_
+#pragma once
+
+#include "include/cef_api_hash.h"
+#include "include/cef_base.h"
+#include "include/views/cef_display.h"
+
+#if CEF_API_ADDED(CEF_EXPERIMENTAL)
+
+///
+/// Implement this interface to be notified of changes to the set of displays
+/// and to their metrics. Register with CefDisplay::AddObserver. The methods of
+/// this interface will be called on the browser process UI thread.
+///
+/*--cef(source=client,added=experimental)--*/
+class CefDisplayObserver : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// Called after |display| has been added, e.g. a monitor was plugged in or
+  /// switched on. CefDisplay::GetAllDisplays includes it from now on.
+  ///
+  /*--cef()--*/
+  virtual void OnDisplayAdded(CefRefPtr<CefDisplay> display) {}
+
+  ///
+  /// Called after |display| has been removed, e.g. a monitor was unplugged or
+  /// switched off. The CefDisplay is a snapshot of the removed display.
+  ///
+  /*--cef()--*/
+  virtual void OnDisplayRemoved(CefRefPtr<CefDisplay> display) {}
+
+  ///
+  /// Called when the metrics (bounds, work area, scale factor, rotation,
+  /// label, ...) of |display| changed.
+  ///
+  /*--cef()--*/
+  virtual void OnDisplayMetricsChanged(CefRefPtr<CefDisplay> display) {}
+};
+
+#endif  // CEF_API_ADDED(CEF_EXPERIMENTAL)
+
+#endif  // CEF_INCLUDE_VIEWS_CEF_DISPLAY_OBSERVER_H_
diff --git a/libcef/browser/views/display_impl.cc b/libcef/browser/views/display_impl.cc
index 6a16816ee..0a50d3d84 100644
--- a/libcef/browser/views/display_impl.cc
+++ b/libcef/browser/views/display_impl.cc
@@ -4,9 +4,61 @@
 
 #include "cef/libcef/browser/views/display_impl.h"
 
+#include <memory>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "cef/include/views/cef_display_observer.h"
 #include "cef/libcef/browser/views/view_util.h"
+#include "ui/display/display_observer.h"
 #include "ui/display/screen.h"
 
+namespace {
+
+// Forwards the notifications of display::Screen to a CefDisplayObserver.
+class CefDisplayObserverAdapter : public display::DisplayObserver {
+ public:
+  explicit CefDisplayObserverAdapter(CefRefPtr<CefDisplayObserver> observer)
+      : observer_(observer), scoped_observer_(this) {}
+
+  CefDisplayObserverAdapter(const CefDisplayObserverAdapter&) = delete;
+  CefDisplayObserverAdapter& operator=(const CefDisplayObserverAdapter&) =
+      delete;
+
+  CefDisplayObserver* observer() const { return observer_.get(); }
+
+  // display::DisplayObserver methods:
+  void OnDisplayAdded(const display::Display& new_display) override {
+    observer_->OnDisplayAdded(new CefDisplayImpl(new_display));
+  }
+
+  void OnDisplaysRemoved(const display::Displays& removed_displays) override {
+    for (const auto& display : removed_displays) {
+      observer_->OnDisplayRemoved(new CefDisplayImpl(display));
+    }
+  }
+
+  void OnDisplayMetricsChanged(const display::Display& display,
+                               uint32_t changed_metrics) override {
+    observer_->OnDisplayMetricsChanged(new CefDisplayImpl(display));
+  }
+
+ private:
+  CefRefPtr<CefDisplayObserver> observer_;
+  // Does nothing when there is no display::Screen (at shutdown).
+  display::ScopedOptionalDisplayObserver scoped_observer_;
+};
+
+using AdapterList = std::vector<std::unique_ptr<CefDisplayObserverAdapter>>;
+
+// Only accessed on the UI thread.
+AdapterList& GetAdapters() {
+  static base::NoDestructor<AdapterList> adapters;
+  return *adapters;
+}
+
+}  // namespace
+
 // static
 CefRefPtr<CefDisplay> CefDisplay::GetPrimaryDisplay() {
   CEF_REQUIRE_UIT_RETURN(nullptr);
@@ -51,6 +103,30 @@ void CefDisplay::GetAllDisplays(std::vector<CefRefPtr<CefDisplay>>& displays) {
   }
 }
 
+// static
+void CefDisplay::AddObserver(CefRefPtr<CefDisplayObserver> observer) {
+  CEF_REQUIRE_UIT_RETURN_VOID();
+  if (!observer) {
+    return;
+  }
+  auto& adapters = GetAdapters();
+  for (const auto& adapter : adapters) {
+    if (adapter->observer() == observer.get()) {
+      return;
+    }
+  }
+  adapters.push_back(std::make_unique<CefDisplayObserverAdapter>(observer));
+}
+
+// static
+void CefDisplay::RemoveObserver(CefRefPtr<CefDisplayObserver> observer) {
+  CEF_REQUIRE_UIT_RETURN_VOID();
+  auto& adapters = GetAdapters();
+  std::erase_if(adapters, [&](const auto& adapter) {
+    return adapter->observer() == observer.get();
+  });
+}
+
 // static
 CefPoint CefDisplay::ConvertScreenPointToPixels(const CefPoint& point) {
   CEF_REQUIRE_UIT_RETURN(CefPoint());
