@@ -620,6 +621,34 @@ void WindowAcceleratorImpl(CefRefPtr<CefWaitableEvent> event) {
 // Test window functionality. This is primarily to exercise exposed CEF APIs
 // and is not intended to comprehensively test window-related behavior (which
 // we presume that Chromium is testing).
+#if CEF_API_ADDED(CEF_EXPERIMENTAL)
+namespace {
+
+class TestDisplayObserver : public CefDisplayObserver {
+ public:
+  TestDisplayObserver() = default;
+
+ private:
+  IMPLEMENT_REFCOUNTING(TestDisplayObserver);
+};
+
+void DisplayObserverAddRemoveImpl(CefRefPtr<CefWaitableEvent> event) {
+  CefRefPtr<CefDisplayObserver> observer = new TestDisplayObserver();
+  // Adding twice is ignored, removing something that is not registered too.
+  CefDisplay::AddObserver(observer);
+  CefDisplay::AddObserver(observer);
+  CefDisplay::RemoveObserver(observer);
+  CefDisplay::RemoveObserver(observer);
+  CefDisplay::AddObserver(nullptr);
+  CefDisplay::RemoveObserver(nullptr);
+  event->Signal();
+}
+
+}  // namespace
+
+WINDOW_TEST_ASYNC(DisplayObserverAddRemove)
+#endif
