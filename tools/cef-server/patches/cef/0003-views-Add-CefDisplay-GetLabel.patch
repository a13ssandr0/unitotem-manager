From 332fc62b141a448cf05c5fe9767536b3c065f08d Mon Sep 17 00:00:00 2001
From: Alessandro Campolo <campolo.alex@gmail.com>
Date: Tue, 20 Oct 2026 21:50:28 +0000
Subject: [PATCH 3/6] views: Add CefDisplay::GetLabel

Expose the label of a display (experimental API). Only implemented on
Wayland, where it is the wl_output description and the only place an
application can learn the output name (wlroots compositors end it with
the connector name, e.g. "Vendor Model (DP-1)"). It is empty on every
other platform and Linux backend: display::Display::label() is set
differently by Windows, macOS and X11 and this API does not expose it.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 include/views/cef_display.h          | 12 ++++++++++++
 libcef/browser/views/display_impl.cc | 10 ++++++++++
 libcef/browser/views/display_impl.h  |  1 +
 3 files changed, 23 insertions(+)

diff --git a/include/views/cef_display.h b/include/views/cef_display.h
index 85d24d188..d37cccd83 100644
--- a/include/views/cef_display.h
+++ b/include/views/cef_display.h
@@ -40,6 +40,7 @@
 
 #include <vector>
 
+#include "include/cef_api_hash.h"
 #include "include/cef_base.h"
 
 ///
@@ -172,6 +173,17 @@ class CefDisplay : public CefBaseRefCounted {
   ///
   /*--cef()--*/
   virtual int GetRotation() = 0;
+
+#if CEF_API_ADDED(CEF_EXPERIMENTAL)
+  ///
+  /// Returns this Display's user-friendly label. Only implemented on Wayland,
+  /// where it is the description of the wl_output (the compositor's make, model
+  /// and, usually, the connector name such as "DP-1"). Empty on every other
+  /// platform and Linux backend (Windows, macOS, X11).
+  ///
+  /*--cef(added=experimental)--*/
+  virtual CefString GetLabel() = 0;
+#endif
 };
 
 #endif  // CEF_INCLUDE_VIEWS_CEF_DISPLAY_H_
diff --git a/libcef/browser/views/display_impl.cc b/libcef/browser/views/display_impl.cc
index 55e5547e5..f4fe07a13 100644
--- a/libcef/browser/views/display_impl.cc
+++ b/libcef/browser/views/display_impl.cc
@@ -152,3 +152,13 @@ int CefDisplayImpl::GetRotation() {
   CEF_REQUIRE_UIT_RETURN(0);
   return display_.RotationAsDegree();
 }
+
+CefString CefDisplayImpl::GetLabel() {
+  CEF_REQUIRE_UIT_RETURN(CefString());
+#if BUILDFLAG(IS_OZONE)
+  if (view_util::IsRunningOnWayland()) {
+    return display_.label();
+  }
+#endif
+  return CefString();
+}
diff --git a/libcef/browser/views/display_impl.h b/libcef/browser/views/display_impl.h
index 4db34a2c2..d681aee90 100644
--- a/libcef/browser/views/display_impl.h
+++ b/libcef/browser/views/display_impl.h
@@ -27,6 +27,7 @@ class CefDisplayImpl : public CefDisplay {
   CefRect GetBounds() override;
   CefRect GetWorkArea() override;
   int GetRotation() override;
+  CefString GetLabel() override;
 
   const display::Display& display() const { return display_; }
 
-- 
