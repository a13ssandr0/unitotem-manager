@@ -42,6 +43,32 @@ namespace ui {
 namespace gbm_wrapper {
 namespace {
 
+// UniTotem: Mesa's gbm_bo_create_with_modifiers() allocates every buffer as scanout capable, and on the Raspberry Pi 4 (V3D)
+// a scanout buffer can only be linear. A Wayland compositor then has to sample linear buffers and presents every frame two
+// vblanks after its commit (30 fps); with the tiled layout (UIF) Mesa picks for a plain render buffer it runs at 60. With
+// UNITOTEM_NO_SCANOUT_BUFFERS set the buffers are created through gbm_bo_create_with_modifiers2() without the scanout flag.
+struct gbm_bo* UnitotemCreateWithModifiers(struct gbm_device* device,
+                                           uint32_t width,
+                                           uint32_t height,
+                                           uint32_t format,
+                                           const uint64_t* modifiers,
+                                           unsigned int count) {
+  using CreateFn = struct gbm_bo* (*)(struct gbm_device*, uint32_t, uint32_t,
+                                      uint32_t, const uint64_t*, unsigned int,
+                                      uint32_t);
+  static const CreateFn create2 =
+      getenv("UNITOTEM_NO_SCANOUT_BUFFERS")
+          ? reinterpret_cast<CreateFn>(
+                dlsym(RTLD_DEFAULT, "gbm_bo_create_with_modifiers2"))
+          : nullptr;
+  if (create2) {
+    return create2(device, width, height, format, modifiers, count,
+                   GBM_BO_USE_RENDERING);
+  }
+  return gbm_bo_create_with_modifiers(device, width, height, format, modifiers,
+                                      count);
+}
+
 uint32_t GetHandleForPlane(struct gbm_bo* bo, int plane) {
   return gbm_bo_get_handle_for_plane(bo, plane).u32;
 }
